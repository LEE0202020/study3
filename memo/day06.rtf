\
1. Uvicorn (ASGI \uc0\u49436 \u48260 )\
   - \uc0\u53364 \u46972 \u51060 \u50616 \u53944 \u47196 \u48512 \u53552  HTTP \u50836 \u52397 \u51012  \u44032 \u51109  \u47676 \u51200  \u48155 \u50500  \u45348 \u53944 \u50892 \u53356  \u49548 \u53011 \u51012  \u50676 \u44256  \
   \uc0\u54028 \u51060 \u50028  \u50528 \u54540 \u47532 \u52992 \u51060 \u49496 \u51004 \u47196  \u51204 \u45804 \u54616 \u45716  \u51200 \u49688 \u51456  \u49436 \u48260 \u51077 \u45768 \u45796 .\
   \uc0\u49892 \u47924  \u54872 \u44221 \u50640 \u49436 \u45716  \u48372 \u53685  \u50526 \u50640  Nginx\u47484  \u46160 \u50612  \u51221 \u51201  \u54028 \u51068  \u52376 \u47532  \u48143  \u47532 \u48260 \u49828  \u54532 \u47197 \u49884 \u47484  \u47585 \u44592 \u44256 , \
   \uc0\u46244 \u50640  Uvicorn\u51012  \u48176 \u52824 \u54633 \u45768 \u45796 .\
\
2. Asyncio Event Loop (\uc0\u48708 \u46041 \u44592  \u51060 \u48292 \u53944  \u47336 \u54532 )\
   - \uc0\u50836 \u52397 \u51060  \u46308 \u50612 \u50732  \u46412 \u47560 \u45796  \u47924 \u44144 \u50868  \u49828 \u47112 \u46300 \u47484  \u49352 \u47196  \u54624 \u45817 \u54616 \u45716  \u48169 \u49885 \u51060  \u50500 \u45768 \u46972 , \
   \uc0\u49905 \u44544  \u49828 \u47112 \u46300  \u44592 \u48152 \u51032  \u48708 \u46041 \u44592  \u51060 \u48292 \u53944  \u47336 \u54532 \u47484  \u49324 \u50857 \u54633 \u45768 \u45796 .\
   DB \uc0\u51312 \u54924 \u45208  \u50808 \u48512  API \u54840 \u52636  \u44057 \u51008  \u45824 \u44592  \u49884 \u44036 (I/O Bound)\u51060  \u48156 \u49373 \u54616 \u47732  \u47688 \u52656 \u51080 \u51648  \u50506 \u44256 , \
   \uc0\u44536 \u46041 \u50504  \u45796 \u47480  \u50836 \u52397 \u51012  \u47676 \u51200  \u52376 \u47532 \u54616 \u47084  \u45336 \u50612 \u44032 \u45716  \u45436 \u48660 \u47196 \u53433 (Non-blocking) \u48169 \u49885 \u51004 \u47196  \u46041 \u51089 \u54633 \u45768 \u45796 .\
\
3. FastAPI \uc0\u46972 \u50864 \u53552  & \u45936 \u53076 \u47112 \u51060 \u53552  (@app.get / @app.post)\
   - \uc0\u48324 \u46020 \u51032  XML \u49444 \u51221  \u54028 \u51068 (web.xml)\u51060 \u45208  \u46972 \u50864 \u54021  \u49444 \u51221  \u54028 \u51068 \u51060  \u50500 \u50696  \u50630 \u49845 \u45768 \u45796 .\
   \uc0\u54028 \u51060 \u50028  \u53076 \u46300  \u50504 \u50640 \u49436  \u45936 \u53076 \u47112 \u51060 \u53552 \u47484  \u51060 \u50857 \u54644  URL \u44221 \u47196 \u50752  \u54632 \u49688 \u47484  \u51649 \u51217  1:1\u47196  \u51649 \u44288 \u51201 \u51004 \u47196  \u47588 \u54609 \u54633 \u45768 \u45796 . \
   (\uc0\u50696 : @app.get("/news"))\
\
4. Path Operation Function (\uc0\u46972 \u50864 \u53552  \u54632 \u49688 ) & Pydantic\
   - \uc0\u51088 \u48148 \u51032  doGet(), doPost()\u52376 \u47100  HTTP \u47700 \u49436 \u46300 \u48324 \u47196  \u48516 \u44592  \u52376 \u47532 \u47484  \u54616 \u44144 \u45208  HttpServletRequest\u47484  \u51068 \u51068 \u51060  \u54028 \u49905 \u54624  \u54596 \u50836 \u44032  \u50630 \u49845 \u45768 \u45796 .\
   \uc0\u54632 \u49688 \u47484  \u49440 \u50616 \u54616 \u47732  FastAPI\u44032  \u50836 \u52397 \u51012  \u48516 \u49437 \u54644 \u51452 \u44256 , Pydantic\u51060  \u45936 \u51060 \u53552  \u50976 \u54952 \u49457  \u44160 \u51613 (Validation)\u44284  \
   \uc0\u53440 \u51077  \u48320 \u54872 \u51012  \u51088 \u46041 \u51004 \u47196  \u44628 \u45140 \u54616 \u44172  \u52376 \u47532 \u54644  \u51469 \u45768 \u45796 .\
\
SOILD \uc0\u50896 \u52825 \
1. \uc0\u45800 \u51068  \u52293 \u51076  \u50896 \u52825  (SRP, Single Responsibility Principle)\
   - \uc0\u54620  \u53364 \u47000 \u49828 , \u54620  \u47784 \u46280 , \u54620  \u54632 \u49688 \u45716  \u50724 \u51649  \u54616 \u45208 \u51032  \u52293 \u51076 \u47564  \u44032 \u51256 \u50556  \u54620 \u45796 .\
     \uc0\u51593  \u54616 \u45208 \u51032  \u46972 \u50864 \u53552 \u45208  \u49436 \u48708 \u49828 \u45716  \u54616 \u45208 \u51032  \u47196 \u51649 \u47564  \u49688 \u54665 \u54644 \u50556  \u54620 \u45796 .\
   - \uc0\u48320 \u44221  \u51060 \u50976 \u44032  \u50668 \u47084  \u44060  \u51080 \u51004 \u47732  \u50504  \u46108 \u45796 .\
   - \uc0\u50976 \u51648 \u48372 \u49688 , \u53580 \u49828 \u53944 , \u54869 \u51109 \u49457  \u54693 \u49345 \u51012  \u50948 \u54620  \u50896 \u52825 \u51060 \u45796 .\
\
2. \uc0\u44060 \u48169 -\u54224 \u49604  \u50896 \u52825  (OCP, Open-Closed Principle)\
   - \uc0\u49548 \u54532 \u53944 \u50920 \u50612  \u50836 \u49548 \u45716  \u54869 \u51109 \u50640 \u45716  \u50676 \u47140  \u51080 \u50612 \u50556  \u54616 \u44256 , \u49688 \u51221 \u50640 \u45716  \u45803 \u54784  \u51080 \u50612 \u50556  \u54620 \u45796 .\
     \uc0\u51593  \u44592 \u51316 \u51032  \u53076 \u46300 \u47484  \u48320 \u44221 \u54616 \u51648  \u50506 \u51004 \u47732 \u49436  \u44592 \u45733 \u51012  \u52628 \u44032 \u54624  \u49688  \u51080 \u46020 \u47197  \u49444 \u44228 \u54644 \u50556  \u54620 \u45796 .\
   - \uc0\u49352 \u47196 \u50868  \u50836 \u44396 \u49324 \u54637 \u51060  \u49373 \u44200 \u46020  \u44592 \u51316  \u53076 \u46300 \u51032  \u49688 \u51221 \u51008  \u52572 \u49548 \u54868 \u54616 \u44256  \u44592 \u45733  \u54869 \u51109 \u51008  \u50976 \u50672 \u54644 \u50556  \u54620 \u45796 .\
   - \uc0\u49884 \u49828 \u53596 \u51032  \u50976 \u50672 \u49457 , \u51116 \u49324 \u50857 \u49457 , \u50976 \u51648 \u48372 \u49688 \u49457 \u51012  \u44537 \u45824 \u54868 \u54616 \u44592  \u50948 \u54620  \u50896 \u52825 \u51060 \u45796 .\
\
3. \uc0\u47532 \u49828 \u53076 \u54532  \u52824 \u54872  \u50896 \u52825  (LSP, Liskov Substitution Principle)\
   - \uc0\u54532 \u47196 \u44536 \u47016 \u51032  \u44061 \u52404 \u45716  \u51221 \u54869 \u49457 \u51012  \u44648 \u46888 \u47532 \u51648  \u50506 \u51004 \u47732 \u49436  \u54616 \u50948  \u53440 \u51077 \u51032  \u51064 \u49828 \u53556 \u49828 \u47196  \u48148 \u44992  \u49688  \u51080 \u50612 \u50556  \u54620 \u45796 .\
     \uc0\u51593  \u48512 \u47784  \u53364 \u47000 \u49828  \u51088 \u47532 \u50640  \u51088 \u49885  \u53364 \u47000 \u49828 \u47484  \u45347 \u50612 \u46020  \u54532 \u47196 \u44536 \u47016 \u51060  \u51032 \u46020 \u45824 \u47196  \u46041 \u51089 \u54644 \u50556  \u54620 \u45796 .\
   - \uc0\u49345 \u49549  \u44288 \u44228 \u50640 \u49436  \u51088 \u49885  \u53364 \u47000 \u49828 \u44032  \u48512 \u47784  \u53364 \u47000 \u49828 \u51032  \u44592 \u45733 \u44284  \u44508 \u50557 \u51012  \u50948 \u48152 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 .\
   - \uc0\u45796 \u54805 \u49457 \u51012  \u50504 \u51204 \u54616 \u44256  \u51068 \u44288 \u49457  \u51080 \u44172  \u51648 \u50896 \u54616 \u44592  \u50948 \u54620  \u50896 \u52825 \u51060 \u45796 .\
\
4. \uc0\u51064 \u53552 \u54168 \u51060 \u49828  \u48516 \u47532  \u50896 \u52825  (ISP, Interface Segregation Principle)\
